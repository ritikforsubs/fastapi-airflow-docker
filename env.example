# PostgreSQL Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=appdb
POSTGRES_HOST=postgres

# Airflow Configuration
AIRFLOW__CORE__FERNET_KEY=UKMzEm3yIuFYEq1y3-2FxPNWSVwRASpahmQ9kQfEr8E=
AIRFLOW__WEBSERVER__SECRET_KEY=airflow_secret_key_12345

# Airflow Admin User
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# =============================================================================
# AWS CONFIGURATION
# =============================================================================
# Replace these with your actual AWS credentials
# To get AWS credentials:
# 1. Go to AWS Console → IAM → Users
# 2. Select your user → Security credentials
# 3. Create access key
# 4. Copy Access Key ID and Secret Access Key

AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# S3 Configuration
# Bucket name where your scripts are stored
S3_BUCKET_NAME=your-s3-bucket-name

# Prefix/folder path in S3 bucket (e.g., 'scripts/' or 'data/')
S3_SCRIPT_PREFIX=scripts/

# =============================================================================
# USAGE
# =============================================================================
# 1. Copy this file: cp env.example .env
# 2. Edit .env with your actual credentials
# 3. Never commit .env to git (it's in .gitignore)
# 4. Restart containers: docker-compose down && docker-compose up -d --build

